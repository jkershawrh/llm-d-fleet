FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /grid-signals-publisher ./cmd/grid-signals-publisher

FROM registry.access.redhat.com/ubi9/ubi-micro:latest
COPY --from=builder /grid-signals-publisher /grid-signals-publisher
USER 65534:65534
EXPOSE 9443 8081
LABEL org.opencontainers.image.source="https://github.com/jkershawrh/llm-d-fleet" \
      org.opencontainers.image.description="Portable pool-level Grid Signals publisher" \
      org.opencontainers.image.licenses="Apache-2.0"
ENTRYPOINT ["/grid-signals-publisher"]
